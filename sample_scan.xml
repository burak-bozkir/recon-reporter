<?xml version="1.0" encoding="UTF-8"?>
<nmaprun scanner="nmap" args="nmap -sC -sV -oX sample_scan.xml 10.10.10.10" version="7.94">
  <host>
    <status state="up"/>
    <address addr="10.10.10.10" addrtype="ipv4"/>
    <hostnames><hostname name="target.thm" type="user"/></hostnames>
    <ports>
      <port protocol="tcp" portid="21">
        <state state="open"/>
        <service name="ftp" product="vsftpd" version="3.0.3"/>
        <script id="ftp-anon" output="Anonymous FTP login allowed (FTP code 230)&#10;drwxr-xr-x 2 ftp ftp 4096 pub"/>
      </port>
      <port protocol="tcp" portid="80">
        <state state="open"/>
        <service name="http" product="Apache httpd" version="2.4.18"/>
        <script id="http-title" output="Apache2 Ubuntu Default Page: It works"/>
        <script id="http-server-header" output="Apache/2.4.18 (Ubuntu)"/>
      </port>
      <port protocol="tcp" portid="2222">
        <state state="open"/>
        <service name="ssh" product="OpenSSH" version="7.2p2 Ubuntu 4ubuntu2.8"/>
        <script id="ssh-hostkey" output="2048 SHA256:xxxx (RSA)"/>
      </port>
    </ports>
  </host>
</nmaprun>
